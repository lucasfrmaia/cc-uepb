        "from transformers import pipeline\n",
        "\n",
        "# Caminho (ou nome) do modelo hospedado no Hugging Face Hub.\n",
        "# Esse modelo Ã© baseado em RoBERTa e foi treinado para anÃ¡lise de sentimento em tweets.\n",
        "model_path = \"cardiffnlp/twitter-roberta-base-sentiment-latest\"\n",
        "\n",
        "# CriaÃ§Ã£o do pipeline de anÃ¡lise de sentimento.\n",
        "# O pipeline Ã© uma abstraÃ§Ã£o da biblioteca Transformers que\n",
        "# facilita o uso do modelo para inferÃªncia (prediÃ§Ã£o).\n",
        "pipe = pipeline(\n",
        "\n",
        "    # model:\n",
        "    # Define qual modelo prÃ©-treinado serÃ¡ carregado.\n",
        "    # Aqui estamos carregando o modelo de classificaÃ§Ã£o de sentimento.\n",
        "    model=model_path,\n",
        "\n",
        "    # tokenizer:\n",
        "    # O tokenizer Ã© responsÃ¡vel por transformar o texto bruto\n",
        "    # em tokens numÃ©ricos que o modelo consegue entender.\n",
        "    #\n",
        "    # Ele:\n",
        "    # - Divide o texto em subpalavras (subword tokenization).\n",
        "    # - Converte cada token em um ID numÃ©rico.\n",
        "    # - Adiciona tokens especiais (ex: <s>, </s>).\n",
        "    # - Ajusta padding e truncamento quando necessÃ¡rio.\n",
        "    #\n",
        "    # Ã‰ ESSENCIAL que o tokenizer seja o mesmo usado no\n",
        "    # treinamento do modelo, por isso usamos o mesmo model_path.\n",
        "    tokenizer=model_path,\n",
        "\n",
        "    # top_k=None:\n",
        "    # Faz com que o modelo retorne TODAS as classes com suas probabilidades.\n",
        "    #\n",
        "    # Se nÃ£o colocarmos isso, o pipeline retorna apenas a classe\n",
        "    # mais provÃ¡vel.\n",
        "    #\n",
        "    # Com top_k=None, recebemos algo como:\n",
        "    # [\n",
        "    #   {'label': 'negative', 'score': 0.12},\n",
        "    #   {'label': 'neutral',  'score': 0.30},\n",
        "    #   {'label': 'positive', 'score': 0.58}\n",
        "    # ]\n",
        "    top_k=None,\n",
        "\n",
        "    # device=\"cuda:0\":\n",
        "    # Define que o modelo serÃ¡ executado na GPU (placa de vÃ­deo),\n",
        "    # especificamente na primeira GPU disponÃ­vel.\n",
        "    #\n",
        "    # Se usÃ¡ssemos:\n",
        "    # device=-1\n",
        "    # ele rodaria na CPU.\n",
        "    #\n",
        "    # Usar GPU acelera bastante a inferÃªncia.\n",
        "    device=\"cuda:0\"\n",
        ")"
      ]
    },
