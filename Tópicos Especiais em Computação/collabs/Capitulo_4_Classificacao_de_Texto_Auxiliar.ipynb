      "source": [
        "import numpy as np\n",
        "from tqdm import tqdm\n",
        "from transformers.pipelines.pt_utils import KeyDataset\n",
        "\n",
        "# Lista onde armazenaremos todas as prediÃ§Ãµes finais do modelo\n",
        "y_pred = []\n",
        "\n",
        "# tqdm adiciona uma barra de progresso ao loop\n",
        "# KeyDataset permite passar apenas a coluna \"text\" do dataset\n",
        "# para o pipeline, evitando carregar outras colunas desnecessÃ¡rias\n",
        "for output in tqdm(pipe(KeyDataset(data[\"test\"], \"text\")), total=len(data[\"test\"])):\n",
        "\n",
        "    # O pipeline retorna uma lista com dicionÃ¡rios no formato:\n",
        "    # [\n",
        "    #   {'label': 'negative', 'score': ...},\n",
        "    #   {'label': 'neutral',  'score': ...},\n",
        "    #   {'label': 'positive', 'score': ...}\n",
        "    # ]\n",
        "    #\n",
        "    # Como a ordem das classes nÃ£o Ã© garantida,\n",
        "    # buscamos explicitamente pelo nome do label.\n",
        "\n",
        "    negative_score = next(item[\"score\"] for item in output if item[\"label\"] == \"negative\")\n",
        "    positive_score = next(item[\"score\"] for item in output if item[\"label\"] == \"positive\")\n",
        "\n",
        "    # Aqui criamos uma binarizaÃ§Ã£o do problema.\n",
        "    #\n",
        "    # O modelo originalmente Ã© treinado para 3 classes:\n",
        "    # negative, neutral e positive.\n",
        "    #\n",
        "    # Exemplo de saÃ­da:\n",
        "    # [\n",
        "    #     {\"label\": \"negative\", \"score\": 0.12},\n",
        "    #     {\"label\": \"neutral\",  \"score\": 0.30},\n",
        "    #     {\"label\": \"positive\", \"score\": 0.58}\n",
        "    # ]\n",
        "    #\n",
        "    # Neste experimento, ignoramos completamente a classe \"neutral\"\n",
        "    # e transformamos o problema em uma classificaÃ§Ã£o binÃ¡ria.\n",
        "    #\n",
        "    # Comparamos apenas as probabilidades de:\n",
        "    # - negative\n",
        "    # - positive\n",
        "    #\n",
        "    # Se negative_score > positive_score â†’ classificamos como 0 (negativo)\n",
        "    # Se positive_score > negative_score â†’ classificamos como 1 (positivo)\n",
        "    #\n",
        "    # Isso Ã© feito usando np.argmax(), que retorna o Ã­ndice do maior valor\n",
        "    # dentro da lista [negative_score, positive_score].\n",
        "    #\n",
        "    # Dessa forma:\n",
        "    # Ã­ndice 0 â†’ negativo\n",
        "    # Ã­ndice 1 â†’ positivo\n",
        "\n",
        "    assignment = np.argmax([negative_score, positive_score])\n",
        "\n",
        "    # Adicionamos a prediÃ§Ã£o final na lista\n",
        "    # Resultado final serÃ¡ algo como:\n",
        "    # [0, 1, 1, 0, 0, 1, ...]\n",
        "    y_pred.append(assignment)"
      ]
    },
