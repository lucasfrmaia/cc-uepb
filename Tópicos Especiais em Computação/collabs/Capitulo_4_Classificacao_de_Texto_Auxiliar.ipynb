        "### FunÃ§Ã£o de geraÃ§Ã£o de texto\n",
        "FunÃ§Ã£o responsÃ¡vel por enviar o prompt e o documento para o modelo e retornar a classificaÃ§Ã£o."
      ],
      "metadata": {
        "id": "g_q1HxMKGzJ8"
      }
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "dGiovm3wyCOz"
      },
      "outputs": [],
      "source": [
        "def chatgpt_generation(prompt, document, model=\"llama-3.1-8b-instant\"):\n",
        "    \"\"\"Gera uma saÃ­da com base em um prompt e um documento de entrada.\"\"\"\n",
        "\n",
        "    # Estrutura de mensagens no formato chat:\n",
        "    # - \"system\" define o comportamento do modelo\n",
        "    # - \"user\" contÃ©m o prompt com o documento a ser classificado\n",
        "    messages = [\n",
        "        {\n",
        "            \"role\": \"system\",\n",
        "            \"content\": \"You are a helpful assistant.\"\n",
        "        },\n",
        "        {\n",
        "            \"role\": \"user\",\n",
        "            # Substitui o placeholder [DOCUMENT] pelo texto real\n",
        "            \"content\": prompt.replace(\"[DOCUMENT]\", document)\n",
        "        }\n",
        "    ]\n",
        "\n",
        "    # Envia a requisiÃ§Ã£o para a API do Groq\n",
        "    # temperature=0 â†’ respostas mais determinÃ­sticas e consistentes\n",
        "    chat_completion = client.chat.completions.create(\n",
        "        messages=messages,\n",
        "        model=model,\n",
        "        temperature=0\n",
        "    )\n",
        "\n",
        "    # Retorna apenas o conteÃºdo textual da resposta\n",
        "    return chat_completion.choices[0].message.content"
      ]
    },
