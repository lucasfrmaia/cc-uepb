            "100%|â–ˆâ–ˆâ–ˆâ–ˆâ–ˆâ–ˆâ–ˆâ–ˆâ–ˆâ–ˆ| 1066/1066 [00:45<00:00, 23.67it/s]\n"
          ]
        }
      ],
      "source": [
        "# Lista para armazenar as prediÃ§Ãµes finais\n",
        "y_pred = []\n",
        "\n",
        "# Percorre cada exemplo do conjunto de teste com barra de progresso\n",
        "for example in tqdm(data[\"test\"], total=len(data[\"test\"])):\n",
        "\n",
        "    # Tokeniza o texto formatado com o prompt e envia para o device (GPU/CPU)\n",
        "    # return_tensors=\"pt\" â†’ retorna tensores PyTorch\n",
        "    # truncation=True â†’ corta textos muito longos para o limite do modelo\n",
        "    inputs = tokenizer(example[\"t5\"], return_tensors=\"pt\", truncation=True).to(device)\n",
        "\n",
        "    # Gera a resposta do modelo a partir dos tokens de entrada\n",
        "    # max_new_tokens=5 â†’ limita a resposta a 5 tokens (suficiente para \"positive\" ou \"negative\")\n",
        "    outputs = model.generate(**inputs, max_new_tokens=5)\n",
        "\n",
        "    # Decodifica os tokens gerados de volta para texto legÃ­vel\n",
        "    # skip_special_tokens=True â†’ remove tokens especiais como <pad>, </s>\n",
        "    # .strip().lower() â†’ remove espaÃ§os e converte para minÃºsculas\n",
        "    text = tokenizer.decode(outputs[0], skip_special_tokens=True).strip().lower()\n",
        "\n",
        "    # Converte o texto gerado para rÃ³tulo numÃ©rico\n",
        "    # \"negative\" â†’ 0 | qualquer outra resposta â†’ 1 (positive)\n",
        "    y_pred.append(0 if text == \"negative\" else 1)"
      ]
    },
