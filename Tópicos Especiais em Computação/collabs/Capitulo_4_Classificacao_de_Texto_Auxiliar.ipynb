      "source": [
        "from sklearn.metrics import classification_report\n",
        "\n",
        "# FunÃ§Ã£o responsÃ¡vel por avaliar o desempenho do modelo\n",
        "# comparando os rÃ³tulos reais (y_true) com as prediÃ§Ãµes (y_pred)\n",
        "def evaluate_performance(y_true, y_pred):\n",
        "\n",
        "    # classification_report gera um relatÃ³rio completo de mÃ©tricas\n",
        "    # de classificaÃ§Ã£o para cada classe.\n",
        "    #\n",
        "    # MÃ©tricas calculadas:\n",
        "    # - Precision  â†’ das prediÃ§Ãµes feitas para uma classe, quantas estavam corretas\n",
        "    # - Recall     â†’ dos exemplos reais da classe, quantos foram corretamente identificados\n",
        "    # - F1-score   â†’ mÃ©dia harmÃ´nica entre precision e recall\n",
        "    # - Support    â†’ quantidade real de exemplos daquela classe no dataset\n",
        "    #\n",
        "    # target_names define os nomes das classes que aparecerÃ£o no relatÃ³rio.\n",
        "    # Como estamos trabalhando com classificaÃ§Ã£o binÃ¡ria:\n",
        "    # 0 â†’ Negative Review\n",
        "    # 1 â†’ Positive Review\n",
        "    performance = classification_report(\n",
        "        y_true,\n",
        "        y_pred,\n",
        "        target_names=[\"Negative Review\", \"Positive Review\"]\n",
        "    )\n",
        "\n",
        "    # Imprime o relatÃ³rio formatado na tela\n",
        "    print(performance)"
      ]
    },
