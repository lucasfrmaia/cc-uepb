        "from transformers import AutoTokenizer, AutoModelForSeq2SeqLM\n",
        "import torch\n",
        "\n",
        "# Nome do modelo no Hugging Face Hub\n",
        "model_name = \"google/flan-t5-small\"\n",
        "\n",
        "# Carrega o tokenizer: converte texto em tokens que o modelo entende\n",
        "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
        "\n",
        "# Carrega o modelo encoder-decoder (Seq2Seq) prÃ©-treinado\n",
        "model = AutoModelForSeq2SeqLM.from_pretrained(model_name)\n",
        "\n",
        "# Verifica se hÃ¡ GPU disponÃ­vel, senÃ£o usa CPU\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "\n",
        "# Move o modelo para o device escolhido (GPU ou CPU)\n",
        "model = model.to(device)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 2ï¸âƒ£ Criar o prompt da tarefa\n"
      ],
      "metadata": {
        "id": "XuIm762wAJ6p"
