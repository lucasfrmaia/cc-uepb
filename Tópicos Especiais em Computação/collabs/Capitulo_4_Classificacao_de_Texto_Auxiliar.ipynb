      "source": [
        "from sentence_transformers import SentenceTransformer\n",
        "\n",
        "# Importa a classe SentenceTransformer,\n",
        "# que permite carregar modelos prÃ©-treinados para gerar embeddings de texto.\n",
        "\n",
        "# Load model\n",
        "model = SentenceTransformer('sentence-transformers/all-mpnet-base-v2')\n",
        "\n",
        "# Carrega o modelo prÃ©-treinado \"all-mpnet-base-v2\",\n",
        "# que Ã© baseado em Transformer (MPNet) e foi treinado para gerar\n",
        "# embeddings semÃ¢nticos de alta qualidade.\n",
        "# Esse modelo transforma frases em vetores numÃ©ricos densos.\n",
        "\n",
        "# Convert text to embeddings\n",
        "train_embeddings = model.encode(data[\"train\"][\"text\"], show_progress_bar=True)\n",
        "test_embeddings = model.encode(data[\"test\"][\"text\"], show_progress_bar=True)\n",
        "\n",
        "# O mÃ©todo .encode() converte cada texto em um vetor numÃ©rico (embedding).\n",
        "# Cada vetor representa semanticamente o significado da frase.\n",
        "#\n",
        "# data[\"train\"][\"text\"] â†’ lista de textos de treino\n",
        "# data[\"test\"][\"text\"]  â†’ lista de textos de teste\n",
        "#\n",
        "# show_progress_bar=True exibe uma barra de progresso durante a geraÃ§Ã£o.\n",
        "#\n",
        "# O resultado:\n",
        "# train_embeddings â†’ matriz NumPy (n_amostras_treino x dimensÃ£o_do_vetor)\n",
        "# test_embeddings  â†’ matriz NumPy (n_amostras_teste x dimensÃ£o_do_vetor)\n",
        "#\n",
        "# Esses embeddings podem ser usados como entrada para modelos de ML\n",
        "# como SVM, Logistic Regression, Random Forest, etc."
      ]
    },
