      "outputs": [],
      "source": [
        "# Define o prompt que instrui o modelo a classificar o sentimento\n",
        "prompt = \"Is the following sentence positive or negative? \"\n",
        "\n",
        "# Para cada exemplo do dataset, cria uma nova coluna \"t5\"\n",
        "# concatenando o prompt com o texto original da resenha\n",
        "# Exemplo:\n",
        "# text  â†’ \"the rock is destined to be the 21st century's new conan\"\n",
        "# t5    â†’ \"Is the following sentence positive or negative? the rock is destined to be the 21st century's new conan\"\n",
        "data = data.map(lambda example: {\"t5\": prompt + example[\"text\"]})"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## 3ï¸âƒ£ Executar inferÃªncia no conjunto de teste\n"
